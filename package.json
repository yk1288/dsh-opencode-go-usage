{
  "name": "@yk1288/dsh-opencode-go-usage",
  "version": "0.1.0",
  "description": "DSH plugin to display OpenCode Go usage and cost in sidebar",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "tsdown": {
    "entry": {
      "index": "src/index.ts"
    },
    "outDir": "lib",
    "format": "esm",
    "clean": true,
    "dts": true
  },
  "license": "Apache-2.0",
  "files": [
    "lib/**/*.mjs",
    "lib/**/*.mjs.map",
    "lib/**/*.d.mts",
    "lib/**/*.d.mts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "public/client.js",
    "install.sh",
    "src",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -b && tsdown && cp public/client.js lib/client.js",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "watch": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yk1288/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/yk1288/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/yk1288/dsh-opencode-go-usage/issues"
  },
  "author": "huangwei",
  "keywords": [
    "dsh",
    "cordis",
    "opencode",
    "usage",
    "sidebar"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
